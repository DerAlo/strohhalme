#property copyright "Strohhalme EA Discovery Pipeline"
#property version   "1.00"
// NOTE: Market-ready version is SP500_TrendFollower_Pro.mq5 (v2.00)

#include <Trade\Trade.mqh>
#include <Trade\PositionInfo.mqh>
#include <Trade\AccountInfo.mqh>
#include <Trade\SymbolInfo.mqh>

CTrade         m_trade;
CPositionInfo  m_position;
CAccountInfo   m_account;
CSymbolInfo    m_symbol;

// --- Entry parameters (from optimization) ---
input int      InpSmaFast       = 28;     // Fast SMA period
input int      InpSmaSlow       = 400;    // Slow SMA period
input double   InpAtrMult       = 0.5;    // ATR multiplier for stop distance
input int      InpAtrPeriod     = 14;     // ATR period
input double   InpLotSize       = 0.1;    // Fixed position size (fallback)
input double   InpRiskPercent   = 1.0;    // Risk per trade (% of equity)
input int      InpMagicNumber   = 202605; // EA magic number

// --- Indicator handles ---
int            smaFastHandle;
int            smaSlowHandle;
int            atrHandle;

//+------------------------------------------------------------------+
//| Expert initialization function                                   |
//+------------------------------------------------------------------+
int OnInit()
{
   // Validate inputs
   if(InpSmaFast >= InpSmaSlow)
   {
      Print("ERROR: Fast SMA must be less than Slow SMA");
      return(INIT_PARAMETERS_INCORRECT);
   }

   // Initialize symbol info
   m_symbol.Name(_Symbol);
   m_symbol.Refresh();

   // Configure trade object
   m_trade.SetExpertMagicNumber(InpMagicNumber);
   m_trade.SetDeviationInPoints(10);

   // Create indicator handles
   smaFastHandle = iMA(_Symbol, PERIOD_CURRENT, InpSmaFast, 0, MODE_SMA, PRICE_CLOSE);
   smaSlowHandle = iMA(_Symbol, PERIOD_CURRENT, InpSmaSlow, 0, MODE_SMA, PRICE_CLOSE);
   atrHandle     = iATR(_Symbol, PERIOD_CURRENT, InpAtrPeriod);

   if(smaFastHandle == INVALID_HANDLE || smaSlowHandle == INVALID_HANDLE || atrHandle == INVALID_HANDLE)
   {
      Print("ERROR: Failed to create indicator handles. Error: ", GetLastError());
      return(INIT_FAILED);
   }

   Print("SP500 Trend Follower EA initialized");
   Print("  SMA Fast=", InpSmaFast, " Slow=", InpSmaSlow, " ATR Mult=", InpAtrMult);
   Print("  Risk=", InpRiskPercent, "%, Lot=", InpLotSize);

   return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
//| Expert deinitialization function                                 |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   IndicatorRelease(smaFastHandle);
   IndicatorRelease(smaSlowHandle);
   IndicatorRelease(atrHandle);
}

//+------------------------------------------------------------------+
//| Expert tick function                                             |
//+------------------------------------------------------------------+
void OnTick()
{
   // Only trade on new daily bar
   static datetime lastBarTime = 0;
   if(TimeCurrent() - lastBarTime < PeriodSeconds(PERIOD_CURRENT) * 0.8)
      return;
   lastBarTime = TimeCurrent();

   // Need enough bars
   if(Bars(_Symbol, PERIOD_CURRENT) < InpSmaSlow + 10)
      return;

   // --- Get indicator values ---
   double smaFast[3], smaSlow[3], atrVal[1];

   if(CopyBuffer(smaFastHandle, 0, 0, 3, smaFast) < 3) return;
   if(CopyBuffer(smaSlowHandle, 0, 0, 3, smaSlow) < 3) return;
   if(CopyBuffer(atrHandle, 0, 0, 1, atrVal) < 1) return;

   double close0 = iClose(_Symbol, PERIOD_CURRENT, 0);
   double atr    = atrVal[0];
   if(atr <= 0) return;

   // --- Determine trend ---
   bool trendUp   = (smaFast[0] > smaSlow[0]);
   bool trendDown = (smaFast[0] < smaSlow[0]);

   // --- Check position ---
   bool hasPosition = false;
   bool isLong = false;
   ulong ticket = 0;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(m_position.SelectByIndex(i) &&
         m_position.Symbol() == _Symbol &&
         m_position.Magic() == InpMagicNumber)
      {
         hasPosition = true;
         isLong = (m_position.PositionType() == POSITION_TYPE_BUY);
         ticket = m_position.Ticket();
         break;
      }
   }

   // --- Manage existing position ---
   if(hasPosition)
   {
      double trailDist = atr * InpAtrMult;

      if(isLong)
      {
         // Trail stop up
         double newStop = m_symbol.Bid() - trailDist;
         double currSL = 0;

         if(m_position.SelectByTicket(ticket))
            currSL = m_position.StopLoss();

         if(newStop > currSL)
         {
            m_trade.PositionModify(ticket, newStop, 0);
         }

         // Exit on trend reversal
         if(trendDown)
         {
            if(m_trade.PositionClose(ticket))
               Print("Long closed: trend reversal");
         }
      }
      else // short
      {
         double newStop = m_symbol.Ask() + trailDist;
         double currSL = 0;

         if(m_position.SelectByTicket(ticket))
            currSL = m_position.StopLoss();

         if(newStop < currSL || currSL == 0)
         {
            m_trade.PositionModify(ticket, newStop, 0);
         }

         if(trendUp)
         {
            if(m_trade.PositionClose(ticket))
               Print("Short closed: trend reversal");
         }
      }
      return; // only one position at a time
   }

   // --- Entry logic ---
   if(trendUp && close0 > smaFast[0])
   {
      double lot = CalcLotSize(atr);
      double sl = m_symbol.Ask() - atr * InpAtrMult;
      if(m_trade.Buy(lot, _Symbol, m_symbol.Ask(), sl, 0, "SP500 TF"))
         Print("Long ", lot, " at ", m_symbol.Ask(), " SL=", sl);
   }
   else if(trendDown && close0 < smaFast[0])
   {
      double lot = CalcLotSize(atr);
      double sl = m_symbol.Bid() + atr * InpAtrMult;
      if(m_trade.Sell(lot, _Symbol, m_symbol.Bid(), sl, 0, "SP500 TF"))
         Print("Short ", lot, " at ", m_symbol.Bid(), " SL=", sl);
   }
}

//+------------------------------------------------------------------+
//| Risk-based position sizing                                       |
//+------------------------------------------------------------------+
double CalcLotSize(double atr)
{
   double equity = m_account.Equity();
   double riskAmount = equity * InpRiskPercent / 100.0;
   double stopDist   = atr * InpAtrMult;
   double tickValue  = m_symbol.TickValue();
   double tickSize   = m_symbol.TickSize();

   if(stopDist <= 0 || tickValue <= 0 || tickSize <= 0)
      return(InpLotSize);

   double ticksInStop = stopDist / tickSize;
   double lot = riskAmount / (ticksInStop * tickValue);

   double lotStep = m_symbol.VolumeStep();
   double minLot  = m_symbol.VolumeMin();
   double maxLot  = m_symbol.VolumeMax();

   lot = MathFloor(lot / lotStep) * lotStep;
   lot = MathMax(minLot, MathMin(maxLot, lot));
   return(lot);
}
//+------------------------------------------------------------------+
