//+------------------------------------------------------------------+
//|                                      BTCUSD_TrendFollower_20_130.mq5 |
//|                                    Generated by Strohhalme v0.2 |
//|           Systematic optimization on BTCUSD H1 2024-2025 (1.4yr)    |
//|              Best: PF=12.26, DD=11.7%, Trades=1101, WinRate=78.5%    |
//+------------------------------------------------------------------+
#property copyright "Strohhalme EA Discovery Pipeline"
#property version   "2.00"
#property link      "https://github.com/DerAlo/strohhalme"
#property description "SMA Trend Follower SMA(20/130) — BTCUSD H1"
#property description "Entry: SMA(20) > SMA(130) = Long, SMA(20) < SMA(130) = Short"
#property description "Exit: ATR trailing stop + trend reversal"
#property description "Protection: break-even, spread filter, max daily loss"

#include <Trade\Trade.mqh>
#include <Trade\PositionInfo.mqh>
#include <Trade\AccountInfo.mqh>
#include <Trade\SymbolInfo.mqh>

CTrade         m_trade;
CPositionInfo  m_position;
CAccountInfo   m_account;
CSymbolInfo    m_symbol;

//+------------------------------------------------------------------+
//| ENTRY PARAMETERS (from optimization)                              |
//+------------------------------------------------------------------+
input int      InpSmaFast       = 20;     // Fast SMA period
input int      InpSmaSlow       = 130;    // Slow SMA period
input double   InpAtrMult       = 0.5;    // ATR multiplier for stop distance
input int      InpAtrPeriod     = 14;     // ATR period

//+------------------------------------------------------------------+
//| MONEY MANAGEMENT                                                  |
//+------------------------------------------------------------------+
input double   InpRiskPercent   = 1.0;    // Risk per trade (% of equity)
input double   InpLotSize       = 0.1;    // Fixed lot size (fallback)

//+------------------------------------------------------------------+
//| PROTECTION PARAMETERS                                             |
//+------------------------------------------------------------------+
input int      InpMagicNumber   = 202617; // EA magic number
input int      InpMaxSpread     = 30;     // Max spread in points (0=off)
input double   InpMaxDailyLoss  = 5.0;    // Max daily loss % (0=off)
input double   InpSlippage      = 3.0;    // Max slippage in points

//+------------------------------------------------------------------+
//| EXIT MANAGEMENT                                                   |
//+------------------------------------------------------------------+
input bool     InpUseBreakeven  = true;   // Enable break-even
input double   InpBreakEvenAtr  = 1.5;    // ATRs to profit before SL→entry
input double   InpBreakEvenLock = 0.25;   // ATR lock above entry after B/E
input bool     InpUseTrailStop  = true;   // Enable trailing stop
input bool     InpUseTakeProfit = false;  // Enable take profit (disable for full trend)
input double   InpTakeProfitAtr = 3.0;    // ATRs for take profit

//+------------------------------------------------------------------+
//| GLOBAL STATE                                                      |
//+------------------------------------------------------------------+
datetime       _lastBarTime     = 0;
double         _dailyStartEquity = 0;
bool           _tradingStopped  = false;
double         _lastEntryPrice  = 0;
datetime       _entryTime       = 0;
ENUM_POSITION_TYPE _entryType   = POSITION_TYPE_BUY;
int            smaFastHandle;
int            smaSlowHandle;
int            atrHandle;

//+------------------------------------------------------------------+
//| Expert initialization function                                    |
//+------------------------------------------------------------------+
int OnInit()
{
   if(InpSmaFast >= InpSmaSlow)
   {
      Print("ERROR: Fast SMA must be less than Slow SMA");
      return(INIT_PARAMETERS_INCORRECT);
   }

   m_symbol.Name(_Symbol);
   m_symbol.Refresh();

   m_trade.SetExpertMagicNumber(InpMagicNumber);
   m_trade.SetDeviationInPoints((int)InpSlippage);
   m_trade.SetAsyncMode(false);
   m_trade.LogLevel(LOG_LEVEL_INFO);

   smaFastHandle = iMA(_Symbol, PERIOD_CURRENT, InpSmaFast, 0, MODE_SMA, PRICE_CLOSE);
   smaSlowHandle = iMA(_Symbol, PERIOD_CURRENT, InpSmaSlow, 0, MODE_SMA, PRICE_CLOSE);
   atrHandle     = iATR(_Symbol, PERIOD_CURRENT, InpAtrPeriod);

   if(smaFastHandle == INVALID_HANDLE || smaSlowHandle == INVALID_HANDLE || atrHandle == INVALID_HANDLE)
   {
      Print("ERROR: Failed to create indicator handles. Error: ", GetLastError());
      return(INIT_FAILED);
   }

   _dailyStartEquity = m_account.Equity();

   Print("BTCUSD Trend Follower SMA(20/130) Pro initialized");
   Print("  SMA ", InpSmaFast, "/", InpSmaSlow, " ATR=", InpAtrMult);
   Print("  B/E @", InpBreakEvenAtr, "x ATR | Trail=", InpUseTrailStop, " TP=", InpUseTakeProfit);
   Print("  Spread=", InpMaxSpread, "pt | MaxDailyLoss=", InpMaxDailyLoss, "%");
   Print("  Risk=", InpRiskPercent, "%");

   return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
//| Expert deinitialization function                                  |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   IndicatorRelease(smaFastHandle);
   IndicatorRelease(smaSlowHandle);
   IndicatorRelease(atrHandle);
}

//+------------------------------------------------------------------+
//| Expert tick function                                              |
//+------------------------------------------------------------------+
void OnTick()
{
   // --- Daily P&L check ---
   if(InpMaxDailyLoss > 0 && !_tradingStopped)
   {
      double pnlPct = (m_account.Equity() - _dailyStartEquity) / _dailyStartEquity * 100.0;
      if(pnlPct < -InpMaxDailyLoss)
      {
         _tradingStopped = true;
         Print("DAILY LOSS LIMIT: ", pnlPct, "% < -", InpMaxDailyLoss, "% — trading stopped");
         CloseAllPositions("daily loss limit");
      }
   }

   if(_tradingStopped)
   {
      datetime todayStart;
      SeriesInfoInteger(_Symbol, PERIOD_D1, SERIES_FIRSTDATE, todayStart);
      static datetime lastCheckDay = 0;
      if(lastCheckDay != todayStart)
      {
         lastCheckDay = todayStart;
         _dailyStartEquity = m_account.Equity();
         _tradingStopped = false;
         Print("New trading day — trading resumed");
      }
      return;
   }

   // --- New bar detection ---
   datetime currentBarTime = iTime(_Symbol, PERIOD_CURRENT, 0);
   if(currentBarTime == _lastBarTime)
      return;
   _lastBarTime = currentBarTime;

   if(Bars(_Symbol, PERIOD_CURRENT) < InpSmaSlow + 10)
      return;

   // --- Get indicator values ---
   double smaFast[3], smaSlow[3], atrVal[1];
   if(CopyBuffer(smaFastHandle, 0, 0, 3, smaFast) < 3) return;
   if(CopyBuffer(smaSlowHandle, 0, 0, 3, smaSlow) < 3) return;
   if(CopyBuffer(atrHandle, 0, 0, 1, atrVal) < 1) return;

   double smaFastPrev = smaFast[1];
   double smaSlowPrev = smaSlow[1];
   double smaFastCurr = smaFast[0];
   double smaSlowCurr = smaSlow[0];
   double closePrev = iClose(_Symbol, PERIOD_CURRENT, 1);
   double atr = atrVal[0];
   if(atr <= 0) return;

   bool trendUp   = (smaFastPrev > smaSlowPrev);
   bool trendDown = (smaFastPrev < smaSlowPrev);
   bool crossUp   = (smaFastPrev <= smaSlowPrev && smaFastCurr > smaSlowCurr);
   bool crossDown = (smaFastPrev >= smaSlowPrev && smaFastCurr < smaSlowCurr);

   // --- Check existing position ---
   bool hasPosition = false;
   bool isLong = false;
   ulong ticket = 0;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(m_position.SelectByIndex(i) &&
         m_position.Symbol() == _Symbol &&
         m_position.Magic() == InpMagicNumber)
      {
         hasPosition = true;
         isLong = (m_position.PositionType() == POSITION_TYPE_BUY);
         ticket = m_position.Ticket();
         break;
      }
   }

   // --- Manage existing position ---
   if(hasPosition)
   {
      ManagePosition(ticket, isLong, atr, smaFastPrev, smaSlowPrev,
                     trendUp, trendDown, crossUp, crossDown);
      return;
   }

   // --- Check spread before entry ---
   if(InpMaxSpread > 0)
   {
      double spread = (m_symbol.Ask() - m_symbol.Bid()) / m_symbol.Point();
      if(spread > InpMaxSpread)
      {
         Print("Spread too wide: ", spread, "pt > ", InpMaxSpread, "pt — skipping entry");
         return;
      }
   }

   // --- Entry logic ---
   double lot = CalcLotSize(atr);
   if(lot <= 0) return;

   if(trendUp && closePrev > smaFastPrev && crossUp)
   {
      double sl = m_symbol.Ask() - atr * InpAtrMult;
      double tp = InpUseTakeProfit ? (m_symbol.Ask() + atr * InpTakeProfitAtr) : 0;
      if(m_trade.Buy(lot, _Symbol, m_symbol.Ask(), sl, tp, "BTC TF"))
      {
         _lastEntryPrice = m_symbol.Ask();
         _entryTime = TimeCurrent();
         _entryType = POSITION_TYPE_BUY;
         Print("Long ", lot, " @ ", m_symbol.Ask(), " SL=", sl, " TP=", tp);
      }
   }
   else if(trendDown && closePrev < smaFastPrev && crossDown)
   {
      double sl = m_symbol.Bid() + atr * InpAtrMult;
      double tp = InpUseTakeProfit ? (m_symbol.Bid() - atr * InpTakeProfitAtr) : 0;
      if(m_trade.Sell(lot, _Symbol, m_symbol.Bid(), sl, tp, "BTC TF"))
      {
         _lastEntryPrice = m_symbol.Bid();
         _entryTime = TimeCurrent();
         _entryType = POSITION_TYPE_SELL;
         Print("Short ", lot, " @ ", m_symbol.Bid(), " SL=", sl, " TP=", tp);
      }
   }
}

//+------------------------------------------------------------------+
//| Manage existing position                                          |
//+------------------------------------------------------------------+
void ManagePosition(ulong ticket, bool isLong, double atr,
                    double smaFast, double smaSlow,
                    bool trendUp, bool trendDown,
                    bool crossUp, bool crossDown)
{
   if(!m_position.SelectByTicket(ticket))
      return;

   double openPrice = m_position.PriceOpen();
   double currSL    = m_position.StopLoss();

   // --- Exit on trend reversal ---
   if((isLong && crossDown) || (!isLong && crossUp))
   {
      if(m_trade.PositionClose(ticket))
         Print(isLong ? "Long" : "Short", " closed: trend reversal cross");
      return;
   }

   // --- Break-even ---
   if(InpUseBreakeven)
   {
      double profitAtrs = 0;
      if(isLong)
         profitAtrs = (m_symbol.Bid() - openPrice) / atr;
      else
         profitAtrs = (openPrice - m_symbol.Ask()) / atr;

      if(profitAtrs >= InpBreakEvenAtr)
      {
         double beSL = isLong ?
            (openPrice + atr * InpBreakEvenLock) :
            (openPrice - atr * InpBreakEvenLock);

         if((isLong && beSL > currSL) || (!isLong && (beSL < currSL || currSL == 0)))
         {
            if(m_trade.PositionModify(ticket, beSL, m_position.TakeProfit()))
               Print("Break-even activated at ", beSL);
         }
      }
   }

   // --- Trailing stop ---
   if(InpUseTrailStop)
   {
      double trailDist = atr * InpAtrMult;
      double newStop = isLong ?
         (m_symbol.Bid() - trailDist) :
         (m_symbol.Ask() + trailDist);

      if((isLong && newStop > currSL) || (!isLong && (newStop < currSL || currSL == 0)))
      {
         if(m_trade.PositionModify(ticket, newStop, m_position.TakeProfit()))
         {
            static double lastTrailLog = 0;
            double trailDelta = MathAbs(newStop - currSL);
            if(trailDelta > atr * 0.5 || currSL == 0)
            {
               Print("Trail: SL moved to ", newStop, " (", trailDist, "pt)");
               lastTrailLog = newStop;
            }
         }
      }
   }
}

//+------------------------------------------------------------------+
//| Risk-based position sizing                                        |
//+------------------------------------------------------------------+
double CalcLotSize(double atr)
{
   double equity = m_account.Equity();
   double riskAmount = equity * InpRiskPercent / 100.0;
   double stopDist   = atr * InpAtrMult;
   double tickValue  = m_symbol.TickValue();
   double tickSize   = m_symbol.TickSize();

   if(stopDist <= 0 || tickValue <= 0 || tickSize <= 0)
      return(InpLotSize);

   double ticksInStop = stopDist / tickSize;
   double lot = riskAmount / (ticksInStop * tickValue);

   double lotStep = m_symbol.VolumeStep();
   double minLot  = m_symbol.VolumeMin();
   double maxLot  = m_symbol.VolumeMax();

   lot = MathFloor(lot / lotStep) * lotStep;
   lot = MathMax(minLot, MathMin(maxLot, lot));
   return(lot);
}

//+------------------------------------------------------------------+
//| Close all open positions of this EA                               |
//+------------------------------------------------------------------+
void CloseAllPositions(string reason)
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(m_position.SelectByIndex(i) &&
         m_position.Symbol() == _Symbol &&
         m_position.Magic() == InpMagicNumber)
      {
         m_trade.PositionClose(m_position.Ticket());
         Print("Position closed: ", reason);
      }
   }
}
//+------------------------------------------------------------------+
