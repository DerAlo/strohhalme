//+------------------------------------------------------------------+
//|                                        SP500_BreakoutSwing.mq5   |
//|                                    Generated by Strohhalme v0.1 |
//|           Based on systematic optimization on SP500 D1 2010-2025 |
//|              Performance: PF=9.60, DD=12.8%, Trades=36           |
//+------------------------------------------------------------------+
#property copyright "Strohhalme EA Discovery Pipeline"
#property version   "1.00"

#include <Trade\Trade.mqh>
#include <Trade\PositionInfo.mqh>
#include <Trade\AccountInfo.mqh>
#include <Trade\SymbolInfo.mqh>

CTrade         m_trade;
CPositionInfo  m_position;
CAccountInfo   m_account;
CSymbolInfo    m_symbol;

// --- Entry parameters (from optimization) ---
input int      InpChannelPeriod = 12;     // Channel lookback (bars)
input double   InpAtrEntry      = 1.5;    // ATR multiplier for breakout threshold
input double   InpAtrTrail      = 1.0;    // ATR multiplier for trailing stop
input int      InpAtrPeriod     = 14;     // ATR period
input double   InpRiskPercent   = 1.0;    // Risk per trade (% of equity)
input int      InpMagicNumber   = 202606; // EA magic number

int            atrHandle;
double         snapHigh = 0, snapLow = 0;
int            snapBar = 0;

//+------------------------------------------------------------------+
//| Expert initialization function                                   |
//+------------------------------------------------------------------+
int OnInit()
{
   m_symbol.Name(_Symbol);
   m_symbol.Refresh();
   m_trade.SetExpertMagicNumber(InpMagicNumber);
   m_trade.SetDeviationInPoints(10);

   atrHandle = iATR(_Symbol, PERIOD_CURRENT, InpAtrPeriod);
   if(atrHandle == INVALID_HANDLE)
      return(INIT_FAILED);

   snapBar = -InpChannelPeriod; // take first snapshot on bar InpChannelPeriod
   return(INIT_SUCCEEDED);
}

void OnDeinit(const int reason)
{
   IndicatorRelease(atrHandle);
}

void OnTick()
{
   static datetime lastBarTime = 0;
   if(TimeCurrent() - lastBarTime < PeriodSeconds(PERIOD_CURRENT) * 0.8)
      return;
   lastBarTime = TimeCurrent();

   if(Bars(_Symbol, PERIOD_CURRENT) < InpChannelPeriod + 10)
      return;

   double atrVal[1];
   if(CopyBuffer(atrHandle, 0, 0, 1, atrVal) < 1) return;
   double atr = atrVal[0];
   if(atr <= 0) return;

   double close0 = iClose(_Symbol, PERIOD_CURRENT, 0);
   double high0  = iHigh(_Symbol, PERIOD_CURRENT, 0);

   // --- Check position ---
   bool hasPosition = false;
   bool isLong = false;
   ulong ticket = 0;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(m_position.SelectByIndex(i) &&
         m_position.Symbol() == _Symbol &&
         m_position.Magic() == InpMagicNumber)
      {
         hasPosition = true;
         isLong = (m_position.PositionType() == POSITION_TYPE_BUY);
         ticket = m_position.Ticket();
         break;
      }
   }

   // --- Manage existing position ---
   if(hasPosition)
   {
      double trailDist = atr * InpAtrTrail;

      if(isLong)
      {
         double newStop = m_symbol.Bid() - trailDist;
         double currSL = 0;
         if(m_position.SelectByTicket(ticket))
            currSL = m_position.StopLoss();
         if(newStop > currSL)
            m_trade.PositionModify(ticket, newStop, 0);
      }
      else
      {
         double newStop = m_symbol.Ask() + trailDist;
         double currSL = 0;
         if(m_position.SelectByTicket(ticket))
            currSL = m_position.StopLoss();
         if(newStop < currSL || currSL == 0)
            m_trade.PositionModify(ticket, newStop, 0);
      }
      return;
   }

   // --- Snapshot management ---
   int currentBar = Bars(_Symbol, PERIOD_CURRENT) - 1;
   if(currentBar >= snapBar + InpChannelPeriod)
   {
      snapBar = currentBar;
      double highs[], lows[];
      ArraySetAsSeries(highs, true);
      ArraySetAsSeries(lows, true);
      if(CopyHigh(_Symbol, PERIOD_CURRENT, 0, InpChannelPeriod, highs) >= InpChannelPeriod &&
         CopyLow(_Symbol, PERIOD_CURRENT, 0, InpChannelPeriod, lows) >= InpChannelPeriod)
      {
         snapHigh = highs[ArrayMaximum(highs, 0, InpChannelPeriod)];
         snapLow  = lows[ArrayMinimum(lows, 0, InpChannelPeriod)];
      }
   }

   if(snapHigh <= 0) return;

   // --- Check breakout ---
   double threshold = atr * InpAtrEntry;
   double lot = CalcLotSize(atr);

   if(close0 > snapHigh + threshold)
   {
      double sl = m_symbol.Ask() - atr * InpAtrTrail;
      if(m_trade.Buy(lot, _Symbol, m_symbol.Ask(), sl, 0, "SP500 BO"))
      {
         Print("Long breakout at ", m_symbol.Ask(), " SL=", sl);
         snapHigh = 0; snapLow = 0;
      }
   }
   else if(close0 < snapLow - threshold)
   {
      double sl = m_symbol.Bid() + atr * InpAtrTrail;
      if(m_trade.Sell(lot, _Symbol, m_symbol.Bid(), sl, 0, "SP500 BO"))
      {
         Print("Short breakout at ", m_symbol.Bid(), " SL=", sl);
         snapHigh = 0; snapLow = 0;
      }
   }
}

double CalcLotSize(double atr)
{
   double equity = m_account.Equity();
   double riskAmount = equity * InpRiskPercent / 100.0;
   double stopDist = atr * InpAtrTrail;
   double tickValue = m_symbol.TickValue();
   double tickSize = m_symbol.TickSize();
   if(stopDist <= 0 || tickValue <= 0 || tickSize <= 0) return(0.01);

   double lot = riskAmount / (stopDist / tickSize * tickValue);
   double lotStep = m_symbol.VolumeStep();
   lot = MathFloor(lot / lotStep) * lotStep;
   return(MathMax(m_symbol.VolumeMin(), MathMin(m_symbol.VolumeMax(), lot)));
}
//+------------------------------------------------------------------+
