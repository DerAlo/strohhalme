//+------------------------------------------------------------------+
//|                                        DAX_BreakoutSwing_Pro.mq5 |
//|                                    Generated by Strohhalme v0.2 |
//|           Systematic optimization on DAX D1 2020-2025 (6yr)      |
//|              Best: PF=10.12, DD=10.6%, Trades=41, WinRate=78%    |
//+------------------------------------------------------------------+
#property copyright "Strohhalme EA Discovery Pipeline"
#property version   "2.00"
#property link      "https://github.com/DerAlo/strohhalme"
#property description "Channel Breakout Swing — DAX Daily"
#property description "Entry: Breakout of fixed channel with ATR filter"
#property description "Exit: ATR trailing stop"
#property description "Protection: break-even, spread filter, max daily loss"

#include <Trade\Trade.mqh>
#include <Trade\PositionInfo.mqh>
#include <Trade\AccountInfo.mqh>
#include <Trade\SymbolInfo.mqh>

CTrade         m_trade;
CPositionInfo  m_position;
CAccountInfo   m_account;
CSymbolInfo    m_symbol;

//+------------------------------------------------------------------+
//| ENTRY PARAMETERS (from optimization)                              |
//+------------------------------------------------------------------+
input int      InpChannelPeriod = 40;     // Channel lookback (bars)
input double   InpAtrEntry      = 0.3;    // ATR multiplier for breakout threshold
input double   InpAtrTrail      = 1.0;    // ATR multiplier for trailing stop
input int      InpAtrPeriod     = 14;     // ATR period

//+------------------------------------------------------------------+
//| MONEY MANAGEMENT                                                  |
//+------------------------------------------------------------------+
input double   InpRiskPercent   = 1.0;    // Risk per trade (% of equity)
input double   InpLotSize       = 0.1;    // Fixed lot size (fallback)

//+------------------------------------------------------------------+
//| PROTECTION PARAMETERS                                             |
//+------------------------------------------------------------------+
input int      InpMagicNumber   = 202607; // EA magic number
input int      InpMaxSpread     = 30;     // Max spread in points (0=off)
input double   InpMaxDailyLoss  = 5.0;    // Max daily loss % (0=off)
input double   InpSlippage      = 3.0;    // Max slippage in points

//+------------------------------------------------------------------+
//| EXIT MANAGEMENT                                                   |
//+------------------------------------------------------------------+
input bool     InpUseBreakeven  = true;   // Enable break-even
input double   InpBreakEvenAtr  = 1.5;    // ATRs to profit before SL→entry
input double   InpBreakEvenLock = 0.25;   // ATR lock above entry after B/E

//+------------------------------------------------------------------+
//| GLOBAL STATE                                                      |
//+------------------------------------------------------------------+
datetime       _lastBarTime     = 0;
datetime       _lastSnapTime    = 0;
double         _snapHigh        = 0;
double         _snapLow         = 0;
int            _cooldownBars    = 0;
double         _dailyStartEquity = 0;
bool           _tradingStopped  = false;

int            atrHandle;

//+------------------------------------------------------------------+
//| Expert initialization function                                    |
//+------------------------------------------------------------------+
int OnInit()
{
   m_symbol.Name(_Symbol);
   m_symbol.Refresh();

   m_trade.SetExpertMagicNumber(InpMagicNumber);
   m_trade.SetDeviationInPoints((int)InpSlippage);
   m_trade.SetAsyncMode(false);
   m_trade.LogLevel(LOG_LEVEL_INFO);

   atrHandle = iATR(_Symbol, PERIOD_CURRENT, InpAtrPeriod);
   if(atrHandle == INVALID_HANDLE)
   {
      Print("ERROR: Failed to create ATR handle. Error: ", GetLastError());
      return(INIT_FAILED);
   }

   _dailyStartEquity = m_account.Equity();

   Print("DAX Breakout Swing Pro initialized");
   Print("  Channel=", InpChannelPeriod, " ATR Entry=", InpAtrEntry, " Trail=", InpAtrTrail);
   Print("  B/E @", InpBreakEvenAtr, "x ATR");
   Print("  Spread=", InpMaxSpread, "pt | MaxDailyLoss=", InpMaxDailyLoss, "%");

   return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
//| Expert deinitialization function                                  |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   IndicatorRelease(atrHandle);
}

//+------------------------------------------------------------------+
//| Expert tick function                                              |
//+------------------------------------------------------------------+
void OnTick()
{
   // --- Daily P&L check ---
   if(InpMaxDailyLoss > 0 && !_tradingStopped)
   {
      double pnlPct = (m_account.Equity() - _dailyStartEquity) / _dailyStartEquity * 100.0;
      if(pnlPct < -InpMaxDailyLoss)
      {
         _tradingStopped = true;
         Print("DAILY LOSS LIMIT: ", pnlPct, "% — trading stopped");
         CloseAllPositions("daily loss limit");
      }
   }

   if(_tradingStopped)
   {
      datetime todayStart;
      SeriesInfoInteger(_Symbol, PERIOD_D1, SERIES_FIRSTDATE, todayStart);
      static datetime lastCheckDay = 0;
      if(lastCheckDay != todayStart)
      {
         lastCheckDay = todayStart;
         _dailyStartEquity = m_account.Equity();
         _tradingStopped = false;
         Print("New trading day — trading resumed");
      }
      return;
   }

   // --- New bar detection ---
   datetime currentBarTime = iTime(_Symbol, PERIOD_CURRENT, 0);
   if(currentBarTime == _lastBarTime)
      return;
   _lastBarTime = currentBarTime;

   if(Bars(_Symbol, PERIOD_CURRENT) < InpChannelPeriod + 10)
      return;

   // --- Cooldown ---
   if(_cooldownBars > 0)
   {
      _cooldownBars--;
      return;
   }

   // --- Get indicator values ---
   double atrVal[1];
   if(CopyBuffer(atrHandle, 0, 0, 1, atrVal) < 1) return;
   double atr = atrVal[0];
   if(atr <= 0) return;

   double closeCurr = iClose(_Symbol, PERIOD_CURRENT, 0);
   double highCurr  = iHigh(_Symbol, PERIOD_CURRENT, 0);
   double lowCurr   = iLow(_Symbol, PERIOD_CURRENT, 0);

   // --- Check existing position ---
   bool hasPosition = false;
   bool isLong = false;
   ulong ticket = 0;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(m_position.SelectByIndex(i) &&
         m_position.Symbol() == _Symbol &&
         m_position.Magic() == InpMagicNumber)
      {
         hasPosition = true;
         isLong = (m_position.PositionType() == POSITION_TYPE_BUY);
         ticket = m_position.Ticket();
         break;
      }
   }

   // --- Manage existing position ---
   if(hasPosition)
   {
      ManagePosition(ticket, isLong, atr, closeCurr, highCurr, lowCurr);
      return;
   }

   // --- Update channel snapshot ---
   if(_lastSnapTime == 0 || currentBarTime >= _lastSnapTime + InpChannelPeriod * 86400)
   {
      int lookback = (int)MathMin(InpChannelPeriod, Bars(_Symbol, PERIOD_CURRENT) - 2);
      _snapHigh = iHigh(_Symbol, PERIOD_CURRENT, iHighest(_Symbol, PERIOD_CURRENT, MODE_HIGH, lookback, 1));
      _snapLow  = iLow(_Symbol, PERIOD_CURRENT, iLowest(_Symbol, PERIOD_CURRENT, MODE_LOW, lookback, 1));
      _lastSnapTime = currentBarTime;
      Print("New channel: high=", _snapHigh, " low=", _snapLow);
   }

   // --- Check spread ---
   if(InpMaxSpread > 0)
   {
      double spread = (m_symbol.Ask() - m_symbol.Bid()) / m_symbol.Point();
      if(spread > InpMaxSpread)
      {
         Print("Spread too wide: ", spread, "pt > ", InpMaxSpread, "pt — skip");
         return;
      }
   }

   // --- Entry logic ---
   double lot = CalcLotSize(atr);
   if(lot <= 0) return;

   // Long: price breaks above channel high + ATR buffer
   if(closeCurr > _snapHigh + atr * InpAtrEntry)
   {
      double sl = m_symbol.Ask() - atr * InpAtrTrail;
      if(m_trade.Buy(lot, _Symbol, m_symbol.Ask(), sl, 0, "DAX BO"))
      {
         Print("Long ", lot, " @ ", m_symbol.Ask(), " SL=", sl, " ChanH=", _snapHigh);
      }
   }
   // Short: price breaks below channel low - ATR buffer
   else if(closeCurr < _snapLow - atr * InpAtrEntry)
   {
      double sl = m_symbol.Bid() + atr * InpAtrTrail;
      if(m_trade.Sell(lot, _Symbol, m_symbol.Bid(), sl, 0, "DAX BO"))
      {
         Print("Short ", lot, " @ ", m_symbol.Bid(), " SL=", sl, " ChanL=", _snapLow);
      }
   }
}

//+------------------------------------------------------------------+
//| Manage existing position                                          |
//+------------------------------------------------------------------+
void ManagePosition(ulong ticket, bool isLong, double atr,
                    double close, double high, double low)
{
   if(!m_position.SelectByTicket(ticket))
      return;

   double openPrice = m_position.PriceOpen();
   double currSL    = m_position.StopLoss();
   double trailDist = atr * InpAtrTrail;

   // --- Trailing stop ---
   if(isLong)
   {
      double newStop = MathMax(currSL, close - trailDist);
      if(newStop > currSL || currSL == 0)
      {
         if(m_trade.PositionModify(ticket, newStop, 0))
         {
            static double lastTrailLog = 0;
            if(MathAbs(newStop - lastTrailLog) > atr * 0.3 || currSL == 0)
            {
               Print("Long trail: ", newStop);
               lastTrailLog = newStop;
            }
         }
      }
   }
   else
   {
      double newStop = (currSL == 0) ? (close + trailDist) : MathMin(currSL, close + trailDist);
      if(newStop < currSL || currSL == 0)
      {
         if(m_trade.PositionModify(ticket, newStop, 0))
         {
            static double lastTrailLog = 0;
            if(MathAbs(newStop - lastTrailLog) > atr * 0.3 || currSL == 0)
            {
               Print("Short trail: ", newStop);
               lastTrailLog = newStop;
            }
         }
      }
   }

   // --- Break-even ---
   if(InpUseBreakeven)
   {
      double profitAtrs = isLong ?
         (close - openPrice) / atr :
         (openPrice - close) / atr;

      if(profitAtrs >= InpBreakEvenAtr)
      {
         double beSL = isLong ?
            (openPrice + atr * InpBreakEvenLock) :
            (openPrice - atr * InpBreakEvenLock);

         if((isLong && beSL > m_position.StopLoss()) ||
            (!isLong && (beSL < m_position.StopLoss() || m_position.StopLoss() == 0)))
         {
            if(m_trade.PositionModify(ticket, beSL, 0))
               Print("B/E @ ", beSL);
         }
      }
   }

   // --- Stop loss hit check (trail triggered) ---
   if(isLong && low <= m_position.StopLoss() && m_position.StopLoss() > 0)
   {
      if(m_trade.PositionClose(ticket))
      {
         Print("Long closed: trailing stop hit at ", low);
         _cooldownBars = 12;
      }
   }
   else if(!isLong && high >= m_position.StopLoss() && m_position.StopLoss() > 0)
   {
      if(m_trade.PositionClose(ticket))
      {
         Print("Short closed: trailing stop hit at ", high);
         _cooldownBars = 12;
      }
   }
}

//+------------------------------------------------------------------+
//| Risk-based position sizing                                        |
//+------------------------------------------------------------------+
double CalcLotSize(double atr)
{
   double equity = m_account.Equity();
   double riskAmount = equity * InpRiskPercent / 100.0;
   double stopDist   = atr * InpAtrTrail;
   double tickValue  = m_symbol.TickValue();
   double tickSize   = m_symbol.TickSize();

   if(stopDist <= 0 || tickValue <= 0 || tickSize <= 0)
      return(InpLotSize);

   double ticksInStop = stopDist / tickSize;
   double lot = riskAmount / (ticksInStop * tickValue);

   double lotStep = m_symbol.VolumeStep();
   double minLot  = m_symbol.VolumeMin();
   double maxLot  = m_symbol.VolumeMax();

   lot = MathFloor(lot / lotStep) * lotStep;
   lot = MathMax(minLot, MathMin(maxLot, lot));
   return(lot);
}

//+------------------------------------------------------------------+
//| Close all positions                                                |
//+------------------------------------------------------------------+
void CloseAllPositions(string reason)
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(m_position.SelectByIndex(i) &&
         m_position.Symbol() == _Symbol &&
         m_position.Magic() == InpMagicNumber)
      {
         m_trade.PositionClose(m_position.Ticket());
         Print("Closed: ", reason);
      }
   }
}
//+------------------------------------------------------------------+
